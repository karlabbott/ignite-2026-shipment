# NinetyNine Freight — estate configuration.
#
# Copy to /etc/shipment/shipment.env on EVERY tier, fill in the password, and
# chmod 640 root:shipment. This is the only file that changes when the estate
# migrates to Azure.
#
# Do NOT commit a populated copy of this file.

# ---------------------------------------------------------------- database --
# On-prem: the Hyper-V internal switch address of rhel-db.
# After migration: the Azure private IP or private DNS name of the same VM.
SHIPMENT_DB_HOST=192.168.90.11
SHIPMENT_DB_PORT=1433
SHIPMENT_DB_NAME=shipping
SHIPMENT_DB_USER=shipping_app
SHIPMENT_DB_PASSWORD=CHANGE_ME

# Short timeouts on purpose: a dead database should surface on the health strip
# in seconds, not block the dashboard for half a minute.
SHIPMENT_DB_LOGIN_TIMEOUT=5
SHIPMENT_DB_QUERY_TIMEOUT=10
SHIPMENT_DB_RETRY_SECONDS=3

# ------------------------------------------------------------------- estate --
# Shown on the health strip when the host is NOT in Azure. IMDS detection
# overrides this automatically once a VM is running on Azure.
SHIPMENT_SITE=on-prem/hyper-v
SHIPMENT_HEARTBEAT_SECONDS=10

# ---------------------------------------------------------------- api tier --
SHIPMENT_BOARD_LIMIT=60
SHIPMENT_CREATE_RATE_LIMIT=5
SHIPMENT_CREATE_RATE_WINDOW=60
SHIPMENT_CREATE_GLOBAL_LIMIT=240
SHIPMENT_CORS_ORIGINS=https://dash.99b.org,https://track.99b.org,http://192.168.90.13

# ---------------------------------------------------------------- web tier --
SHIPMENT_API_URL=http://192.168.90.12:8080
SHIPMENT_API_TIMEOUT=5
SHIPMENT_BRAND=NinetyNine Freight

# The public tracking address printed on the dashboard for the audience.
#
# LEAVE THIS BLANK ON HYPER-V. There is no DNS pointing at the lab subnet, so
# the web tier derives the address from the request and shows
# http://192.168.90.13/track -- which is the only thing anyone can reach.
#
# AFTER MIGRATION, once track.99b.org resolves to the Azure front end, set:
#   SHIPMENT_TRACK_URL=https://track.99b.org
# That is the last line of the migration and the only one the audience sees.
SHIPMENT_TRACK_URL=

SHIPMENT_REFRESH_MS=3000

# ------------------------------------------------------------- worker tier --
SHIPMENT_POLL_SECONDS=1
SHIPMENT_MAX_IDLE_SECONDS=5
SHIPMENT_ERROR_BACKOFF=5
SHIPMENT_SCAN_DELAY_MIN=1.5
SHIPMENT_SCAN_DELAY_MAX=4.0

# Ambient movement so the board is never static during a talk.
SHIPMENT_DRIFT_ENABLED=true
SHIPMENT_DRIFT_INTERVAL=20
SHIPMENT_DRIFT_BATCH=3
SHIPMENT_DRIFT_MIN_AGE=45
