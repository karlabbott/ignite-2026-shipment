[Unit]
Description=Zava Logistics API (SUSE tier)
Documentation=https://github.com/karlabbott/ignite-2026-shipment
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=shipment
Group=shipment
WorkingDirectory=/opt/shipment
Environment=PYTHONPATH=/opt/shipment
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/shipment/shipment.env
ExecStart=/opt/shipment/venv/bin/uvicorn api.app.main:app \
    --host 0.0.0.0 --port 8080 --proxy-headers --forwarded-allow-ips='*'
Restart=always
RestartSec=5

# The API tier is a CIS hardening target later in the demo. These are the
# baseline confinements; the hardening act adds to them rather than starting
# from nothing.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
